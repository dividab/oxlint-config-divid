{
  "permissions": {
    "allow": [
      "Bash(cat > *)",
      "Bash(pnpm install *)",
      "Bash(pnpm build*)",
      "Bash(pnpm cleanbuild)",
      "Bash(pnpm clean-node-modules)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm test*)",
      "Bash(pnpm fmt*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm why *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git --no-pager diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git blame *)",
      "Bash(git fetch *)",
      "Bash(git remote *)",
      "Bash(git stash list *)",
      "Bash(git stash push *)",
      "Bash(git stash pop *)",
      "Bash(git stash show *)",
      "Bash(git rev-parse *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(head *)",
      "Bash(echo *)",
      "Bash(xargs *)"
    ],
    "deny": ["Read(.claude/settings.json)", "Write(.claude/settings.json)"],
    "additionalDirectories": ["/tmp"]
  }
}
