{
  "name": "oxlint-config-divid",
  "version": "1.3.6",
  "description": "Oxlint sharable config using typescript with the programming style we use at Divid",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "type": "module",
  "files": [
    "lib"
  ],
  "author": "Divid AB",
  "license": "MIT",
  "packageManager": "pnpm@12.3.1",
  "engines": {
    "node": ">=24.0.0",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dividab/oxlint-config-divid"
  },
  "bugs": {
    "url": "https://github.com/dividab/oxlint-config-divid/issues"
  },
  "keywords": [
    "oxlint",
    "oxlintconfig",
    "config",
    "divid",
    "javascript",
    "typescript"
  ],
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-config-divid": "link:.",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "oxlint": ">=1.81.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "cleanbuild": "rm -rf lib && pnpm build",
    "clean-node-modules": "rm -rf node_modules",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm typecheck && pnpm build",
    "test": "vitest run",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint -c oxlint.config.js .",
    "prelint": "pnpm build",
    "prepack": "pnpm build",
    "preversion": "pnpm fmt:check && pnpm lint && pnpm test",
    "postversion": "git push --tags && git push",
    "release:patch": "scripts/release.sh patch",
    "release:minor": "scripts/release.sh minor",
    "release:major": "scripts/release.sh major",
    "release:publish-only": "scripts/release.sh publish-only"
  }
}