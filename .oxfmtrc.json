{
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 150,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "es5",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "sortPackageJson": true,
  "sortImports": { "newlinesBetween": false },
  "bracketSpacing": true,
  "jsdoc": true,
  "ignorePatterns": ["package.json"]
}
